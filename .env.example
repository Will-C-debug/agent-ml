# Copy to .env and fill in. The CLI loads .env from the current directory.

# Needed for the default model (anthropic:claude-opus-5-5).
ANTHROPIC_API_KEY=

# LLM that drives the agent, as "<provider>:<model>" (any LangChain init_chat_model string).
# Fully local alternative: ML_AGENT_MODEL=ollama:qwen3:14b  (pip install "ml-agent[ollama]")
# ML_AGENT_MODEL=anthropic:claude-opus-5-5

# Reasoning effort for Claude models: low | medium | high | xhigh | max
# ML_AGENT_EFFORT=high

# Where datasets, experiments, exports, reports and conversation history are stored.
# ML_AGENT_WORKSPACE=./ml_workspace

# Upper bound (seconds) the agent may spend on a single AutoML search.
# ML_AGENT_MAX_TIME_BUDGET=900

# Timeout (seconds) for each run_python execution.
# ML_AGENT_PYTHON_TIMEOUT=300

# Set to 1 to run Python code without asking for approval first.
# ML_AGENT_AUTO_APPROVE=0

# Model calls allowed per user turn (guards against runaway loops).
# ML_AGENT_MAX_MODEL_CALLS=80

# Claude's server-side refusal fallback. Set to 0 behind gateways that reject beta parameters.
# ML_AGENT_ANTHROPIC_FALLBACKS=1
